<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MoreDrugs\Content\Mdma\Batch\*.cs"
             Exclude="..\..\src\MoreDrugs\Content\Mdma\Batch\MdmaBatchPersistencePatches.cs;..\..\src\MoreDrugs\Content\Mdma\Batch\MdmaBatchRegistry.cs;..\..\src\MoreDrugs\Content\Mdma\Batch\MdmaProductionPatches.cs"
             Link="Content\Mdma\Batch\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\MoreDrugs\Content\Mdma\Production\ManualTabletPressEjection.cs"
             Link="Content\Mdma\Production\ManualTabletPressEjection.cs" />
    <Compile Include="..\..\src\MoreDrugs\Content\Mdma\Production\ManualTabletPressWheel.cs"
             Link="Content\Mdma\Production\ManualTabletPressWheel.cs" />
    <Compile Include="..\..\src\MoreDrugs\Content\Mdma\Production\ManualTabletPressQuantities.cs"
             Link="Content\Mdma\Production\ManualTabletPressQuantities.cs" />
    <None Include="..\..\src\MoreDrugs\Assets\Models\manual_tablet_press.glb"
          Link="Assets\manual_tablet_press.glb"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MoreDrugs\Assets\Models\mdma_crystals.glb"
          Link="Assets\mdma_crystals.glb"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
